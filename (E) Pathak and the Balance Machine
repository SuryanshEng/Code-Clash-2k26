import sys

def solve():
    data = list(map(int, sys.stdin.buffer.read().split()))
    idx = 0

    t = data[idx]
    idx += 1

    results = []

    for _ in range(t):
        n = data[idx]
        idx += 1

        a = data[idx:idx+n]
        idx += n

        c = data[idx:idx+n]
        idx += n

        prefix = [0] * (n + 1)

        for i in range(n):
            prefix[i+1] = prefix[i] + a[i]

        if prefix[n] < 0:
            results.append(-1)
            continue

        L = -1
        R = -1

        for i in range(1, n+1):
            if prefix[i] < 0:
                if L == -1:
                    L = i
                R = i

        if L == -1:
            results.append(0)
            continue

        ans = float('inf')
        current_min = float('inf')

        for i in range(R, L-1, -1):
            current_min = min(current_min, prefix[i])

        for i in range(L-1, -1, -1):
            current_min = min(current_min, prefix[i+1])

            if current_min >= a[i]:
                ans = min(ans, c[i])

        results.append(-1 if ans == float('inf') else ans)

    print(*results)


solve()
